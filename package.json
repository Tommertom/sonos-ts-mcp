{
  "name": "sonos-ts-mcp",
  "version": "1.4.2",
  "description": "Model Context Protocol server for Sonos audio devices",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sonos-ts-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "npm run build",
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:discovery": "tsx scripts/test-discovery.ts",
    "test:resolution": "tsx scripts/test-device-resolution.ts",
    "test:events": "tsx scripts/test-events.ts",
    "test:phase1": "tsx scripts/test-phase1.ts",
    "test:phase2": "tsx scripts/test-phase2.ts",
    "test:phase3": "tsx scripts/test-phase3.ts",
    "test:phase4": "tsx scripts/test-phase4.ts",
    "test:all-phases": "tsx scripts/test-all-phases.ts",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "sonos",
    "upnp",
    "mcp",
    "model-context-protocol"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
